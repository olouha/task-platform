# TaskPlatform 环境变量配置
# 复制此文件为 .env 并填入实际值

# ========== 数据库配置 ==========
# Supabase 数据库地址
SUPABASE_URL=https://your-project.supabase.co

# Supabase API Key (anon key 或 service role key)
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ========== AI 服务配置 ==========
# AI 服务地址 (OpenAI 兼容)
AI_API_URL=https://api.openai.com/v1

# AI 服务密钥
AI_API_KEY=sk-your-api-key

# ========== 应用配置 ==========
# 服务端口
PORT=8000

# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ========== 可选配置 ==========
# 加密存储主密钥 (用于加密敏感凭据)
# TASKPLATFORM_MASTER_KEY=your-strong-password

# Redis 连接 (用于缓存和队列)
# REDIS_URL=redis://localhost:6379/0

# 我的钢铁网账号（用于登录抓取价格）
# MYSTEEL_USERNAME=M6616592358
# MYSTEEL_PASSWORD=your-password
