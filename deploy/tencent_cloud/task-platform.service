[Unit]
Description=TaskPlatform FastAPI Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/task-platform/web/backend
Environment="PATH=/opt/task-platform/venv/bin"
EnvironmentFile=/opt/task-platform/web/backend/.env
ExecStart=/opt/task-platform/venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8000 --workers 2
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
